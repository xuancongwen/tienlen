{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@engine/*": ["src/engine/*"],
      "@ai/*": ["src/ai/*"],
      "@net/*": ["src/net/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/preload/**/*",
    "src/engine/**/*",
    "src/ai/**/*",
    "src/net/**/*"
  ]
}
